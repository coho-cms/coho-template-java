# A Coho project token with read access, for ./gradlew cohoInit and cohoPull, and for
# ./gradlew catalog --args=--preview. Copy this file to .env for local runs; CI sets
# COHO_TOKEN as a secret. Never deploy it with a site or service.
COHO_TOKEN=

# For the catalog, which reads released content the way an app does: where delivery is,
# and a delivery key for the project.
COHO_DELIVERY_URL=https://delivery.coho.example
COHO_DELIVERY_KEY=
# The tag or environment to read. Empty means the ref in coho.config.json.
COHO_REF=
